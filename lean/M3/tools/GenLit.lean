import RCert.M3.Data

open R45.M3

/-- Print `teffD D.data` as a Lean literal module. -/
def main : IO Unit := do
  let te := teffD D.data
  IO.println "/-! Generated by RCert/M3/GenLit.lean: the values of `teffD D.data` (exact rationals). -/"
  IO.println ""
  IO.println "namespace R45.M3"
  IO.println ""
  IO.println "/-- The certified `T(c)` bounds as literals (`c = 0, …, 119`). -/"
  IO.println "def teffLit : List Rat := ["
  let n := te.length
  for (q, i) in te.zip (List.range n) do
    let sep := if i + 1 < n then "," else "]"
    IO.println s!"  ({q.num} : Rat) / {q.den}{sep}"
  IO.println ""
  IO.println "end R45.M3"

#eval main
