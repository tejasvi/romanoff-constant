import K45.Lag.Defs

/-! `k45genlag CHUNK OUTDIR`: native evaluation of the per-chunk triples of `orbits 120 (ellPO.map (·.1))` (chunks of
CHUNK orbits, in order) and generation of the kernel shards `OUTDIR/C<iii>.lean` (`chunkOK K45.orbs<iii> loU loV hiD`
with the bounds rounded outward at 10^-24), the bounds list `OUTDIR/Bounds.lean`, and the summary `OUTDIR/BOUNDS.txt`
(the literal sums against the claims). -/

open R45 R45.D45 R45.P45 R45.K45L

def pad3 (i : Nat) : String := if i < 10 then s!"00{i}" else if i < 100 then s!"0{i}" else s!"{i}"

def scale : Nat := 10 ^ 24

def floorS (q : Rat) : Int := (q * (scale : Rat)).floor
def ceilS (q : Rat) : Int := (q * (scale : Rat)).ceil

def ratLit (z : Int) : String := s!"({z} / {scale} : Rat)"

def main (args : List String) : IO Unit := do
  let chunk := (args.getD 0 "500").toNat!
  let out := args.getD 1 "K45/Lag"
  let os := orbits per (ellPO.map (·.1))
  let n := os.length
  let k := (n + chunk - 1) / chunk
  let mut bounds : Array (Int × Int × Int) := #[]
  for i in List.range k do
    let part := (os.drop (i * chunk)).take chunk
    let r := chunkVals part
    let b := (floorS r.1, floorS r.2.1, ceilS r.2.2)
    bounds := bounds.push b
    let src := s!"import K45.Orb.O{pad3 i}\nimport K45.Lag.Defs\n\n/-! Generated by K45/GenLag.lean: chunk {i} (orbits {i * chunk} .. {i * chunk + part.length - 1}). -/\n\nset_option maxRecDepth 100000\n\nnamespace R45.K45L\n\ntheorem c{pad3 i}_ok : chunkOK K45.Orb.orbs{pad3 i} {ratLit b.1} {ratLit b.2.1} {ratLit b.2.2} = true := by\n  decide +kernel\n\nend R45.K45L\n"
    IO.FS.writeFile s!"{out}/C{pad3 i}.lean" src
  let bl := ",\n  ".intercalate (bounds.toList.map fun b => s!"({ratLit b.1}, {ratLit b.2.1}, {ratLit b.2.2})")
  IO.FS.writeFile s!"{out}/Bounds.lean" s!"/-! Generated by K45/GenLag.lean: the per-chunk bounds (loU, loV, hiD), scale 10^24. -/\n\nnamespace R45.K45L\n\ndef lagBounds : List (Rat × Rat × Rat) := [\n  {bl}]\n\nend R45.K45L\n"
  let sU : Rat := (bounds.toList.map fun b => (b.1 : Rat) / scale).foldl (· + ·) 0
  let sV : Rat := (bounds.toList.map fun b => (b.2.1 : Rat) / scale).foldl (· + ·) 0
  let sD : Rat := (bounds.toList.map fun b => (b.2.2 : Rat) / scale).foldl (· + ·) 0
  let v3 := sV - muV3 * C1v3 * kap * ((1 / (ellN : Rat)) * sD)
  let okU := decide ((109406 : Rat) / 1000000 ≤ sU)
  let okV := decide ((117953 : Rat) / 1000000 ≤ v3)
  IO.FS.writeFile s!"{out}/BOUNDS.txt" s!"orbits {n}\nchunks {k}\nchunk {chunk}\nsumU_lo {(sU * 1000000000000).floor} e-12 (>= 0.109406: {okU})\nv3_lo {(v3 * 1000000000000).floor} e-12 (>= 0.117953: {okV})\n"
  IO.println s!"orbits {n}, chunks {k}; U2 {okU} v3 {okV}"
