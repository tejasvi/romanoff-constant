import RCert.M3E.Data

/-! `m3egenlit`: print the module `RCert/M3E/TeffLit.lean`, the values of `teffD D.data` (3960 exact rationals) and
`R0tD D.data` at period 3960 for the U3e modulus. -/

open R45.M3 hiding PER accG sumDvd certOK ellPs mkBD prC drC tbC teffOf bsOf teffD
open R45.M3E

def main : IO Unit := do
  let te := teffD D.data
  let r0 := R0tD D.data
  IO.println "/-! Generated by RCert/M3E/GenLit.lean (exe m3egenlit): `teffD D.data` and `R0tD D.data` at period 3960. -/"
  IO.println ""
  IO.println "namespace R45.M3E"
  IO.println ""
  IO.println "/-- The tail mass bound `R0up - (R0a + R0b) / SC` of the M3 tables (U3e modulus). -/"
  IO.println s!"def R0tLit : Rat := ({r0.num} : Rat) / {r0.den}"
  IO.println ""
  IO.println "/-- The certified `T(c)` bounds at period 3960 as literals (`c = 0, …, 3959`). -/"
  IO.println "def teffLit : List Rat := ["
  let n := te.length
  for (q, i) in te.zip (List.range n) do
    let sep := if i + 1 < n then "," else "]"
    IO.println s!"  ({q.num} : Rat) / {q.den}{sep}"
  IO.println ""
  IO.println "end R45.M3E"
