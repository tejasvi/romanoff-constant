import GK.Util

/-! k45g: generate the chunk glue modules GK/Glue/C000..C063 (chunks of 123 BASE keys, as K45G.lg_000..lg_063) and the chunk totals C000.T..C063.T.
The literal trees come from the compiled evaluator; every one is re-checked by the kernel (`decide +kernel`). -/

open R45 R45.EVG R45.GK

def pad3 (i : Nat) : String := if i < 10 then s!"00{i}" else if i < 100 then s!"0{i}" else s!"{i}"
def pad4 (i : Nat) : String := if i < 10 then s!"000{i}" else if i < 100 then s!"00{i}" else if i < 1000 then s!"0{i}" else s!"{i}"

/-- Slotwise sum (same definition as `Acc.plus` of GK/Glue.lean, kept here so that the generator does not import Mathlib). -/
def plusTree : Acc → Acc → Acc
  | .leaf a q, .leaf a' q' => .leaf (a + a') (q + q')
  | .node l r, .node l' r' => .node (plusTree l l') (plusTree r r')
  | t, _ => t

/-- Slotwise multiple (as `Acc.scale`). -/
def scaleTree (c : Nat) : Acc → Acc
  | .leaf a q => .leaf (c * a) (c * q)
  | .node l r => .node (scaleTree c l) (scaleTree c r)

def chunkModule (n : Nat) (keys : List (Nat × Nat × Nat)) (T : Acc) (kts : List Acc) : String := Id.run do
  let mut s := s!"import GK.Glue3\nimport K45G.LG_{pad3 (n / 8)}\n"
  for (k, _, _) in keys do
    s := s ++ s!"import GK.Keys.K{pad4 k}\n"
  s := s ++ s!"\n/-! k45g: glue of chunk {n} (BASE keys {(keys.headD (0,0,0)).1} .. {(keys.getLastD (0,0,0)).1}); generated by GK/GenGlue3.lean. -/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\nnamespace R45.GK.C{pad3 n}\n\nopen R45.GK\n"
  for ((k, x, _), t) in keys.zip kts do
    let rws := ", ".intercalate ((List.range 21).map fun j => s!"(Acc.beq_iff _ _).mp R45.GK.K{pad4 k}.r{j}")
    s := s ++ s!"\ndef kt{pad4 k} : Acc := {t.lean}\n\ntheorem kt{pad4 k}_eq : evalKeyK {x} = kt{pad4 k} := by\n  rw [evalKeyK_eq21, {rws}]\n  exact (Acc.beq_iff _ _).mp (by decide +kernel)\n"
  let pairs := ", ".intercalate (keys.map fun (k, _, c) => s!"(kt{pad4 k}, {c})")
  let eqs := ", ".intercalate (keys.map fun (k, _, _) => s!"kt{pad4 k}_eq")
  s := s ++ s!"\ndef T : Acc := {T.lean}\n\ntheorem chunk_eq \{vt : ℕ → ℕ → ℕ → ℚ} (hvt : Romanoff.G.S2.Lin vt) :\n    (K45G.lg_{pad3 n}.map fun xc => (xc.2 : ℚ) * VfA vt (evalKeyK xc.1)).sum = VfA vt T := by\n  apply chunk_value hvt K45G.lg_{pad3 n} [{pairs}]\n  · simp only [K45G.lg_{pad3 n}, List.map_cons, List.map_nil, {eqs}]\n  · exact (Acc.beq_iff _ _).mp (by decide +kernel)\n\ntheorem T_wf : Acc.WF 6 T := Acc.wf_of_wfb 6 T (by decide +kernel)\n\nend R45.GK.C{pad3 n}\n"
  return s

def main (args : List String) : IO Unit := do
  let n0 := (args.getD 0 "0").toNat!
  let n1 := (args.getD 1 "0").toNat!
  let out := args.getD 2 "GK/Glue"
  let ks := keysG
  for n in List.range (n1 + 1 - n0) do
    let c := n0 + n
    let keys := ((List.range 123).filterMap fun i => (ks[123 * c + i]?).map fun xc => (123 * c + i, xc.1, xc.2))
    let kts := keys.map fun (_, x, _) => evalKeyK x
    let T := (keys.zip kts).foldl (fun acc ((_, _, cnt), t) => plusTree acc (scaleTree cnt t)) (Acc.zero 6)
    IO.FS.writeFile s!"{out}/C{pad3 c}.lean" (chunkModule c keys T kts)
    IO.FS.writeFile s!"{out}/C{pad3 c}.T" T.lean
    IO.println s!"chunk {c}: {keys.length} keys"
