import GK.Util

/-! k45g: generate the kernel modules of BASE keys `start .. start + count - 1` (one module per key: 21 theorems, one per
option of 41). The literals come from the compiled evaluator; the kernel re-evaluates `evalRestK` and checks them. -/

open R45 R45.EVG R45.GK

def pad4 (i : Nat) : String := if i < 10 then s!"000{i}" else if i < 100 then s!"00{i}" else if i < 1000 then s!"0{i}" else s!"{i}"

def keyModule (i : Nat) (x cnt : Nat) : String := Id.run do
  let mut s := s!"import GK.Ev\n\n/-! k45g: BASE key index {i} (x = {x}, count {cnt}); generated by GK/GenKeys.lean. -/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\nnamespace R45.GK.K{pad4 i}\n\nopen R45.GK\n"
  for j in List.range o41r.length do
    s := s ++ s!"\ntheorem r{j} : (evalRestK {x} {j}).beq {(evalRestK x j).lean} = true := by\n  decide +kernel\n"
  s := s ++ s!"\nend R45.GK.K{pad4 i}\n"
  return s

def main (args : List String) : IO Unit := do
  let start := (args.getD 0 "0").toNat!
  let count := (args.getD 1 "1").toNat!
  let out := args.getD 2 "GK/Keys"
  let ks := keysG
  for i in List.range count do
    let k := start + i
    match ks[k]? with
    | some xc => IO.FS.writeFile s!"{out}/K{pad4 k}.lean" (keyModule k xc.1 xc.2)
    | none => pure ()
  IO.println s!"wrote keys {start} .. {start + count - 1} (of {ks.length})"
