/-!
# K1: the BASE fold list of U3g/V4g, kernel-checked

`foldBase_eq : foldOrbits 120 [3, 5, 7, 11, 13, 17, 31, 241] = LG`. Steps 1-7 (the primes 3, 5, 7, 11, 13, 17, 31) are
the kernel checks of K45 (`K45.S.s1`-`s7`, `p1`-`p7`, the same proofs as `K45.step1`-`step7`), ending at the checkpoint
`L7` (18 chunks). The 241 step is new: the 18 chunk products `normK (prodK 120 c7_j opts241) = bg_j` (`sg_j`), their
merge `mergeRuns BGs = LG` (`sgm`) and `strictPos LG = true` (`pG`), then `step_check` and `step_exact`. The literals
are generated by tools/KGenG.lean.
-/

set_option maxRecDepth 100000

namespace K45G

open R45 K45 K45.G

theorem step1 : foldStep 120 [(0, 1)] (optsP 120 3) = L1 := by
  rw [S.opts3_eq]
  exact step_of_normK (by decide) S.opts3_pos S.s1 S.p1

theorem step2 : foldStep 120 L1 (optsP 120 5) = L2 := by
  rw [S.opts5_eq]
  exact step_of_normK (strictPos_spec _ S.p1).2 S.opts5_pos S.s2 S.p2

theorem step3 : foldStep 120 L2 (optsP 120 7) = L3 := by
  rw [S.opts7_eq]
  exact step_of_normK (strictPos_spec _ S.p2).2 S.opts7_pos S.s3 S.p3

theorem step4 : foldStep 120 L3 (optsP 120 11) = L4 := by
  rw [S.opts11_eq]
  exact step_of_normK (strictPos_spec _ S.p3).2 S.opts11_pos S.s4 S.p4

theorem step5 : foldStep 120 L4 (optsP 120 13) = L5 := by
  rw [S.opts13_eq]
  exact step_of_normK (strictPos_spec _ S.p4).2 S.opts13_pos S.s5 S.p5

theorem step6 : foldStep 120 L5 (optsP 120 17) = L6 := by
  rw [S.opts17_eq]
  exact step_of_normK (strictPos_spec _ S.p5).2 S.opts17_pos S.s6 S.p6

theorem step7 : foldStep 120 L6 (optsP 120 31) = L7 := by
  rw [S.opts31_eq]
  exact step_of_normK (strictPos_spec _ S.p6).2 S.opts31_pos S.s7 S.p7

/-- The new step: the prime 241 on the checkpoint `L7`. -/
theorem step241 : foldStep 120 L7 (optsP 120 241) = LG := by
  rw [S.opts241_eq]
  have hB : List.Forall₂ (fun C B => normK (prodK 120 C opts241) = B) L7chunks BGs :=
    .cons sg_000 (.cons sg_001 (.cons sg_002 (.cons sg_003 (.cons sg_004 (.cons sg_005 (.cons sg_006 (.cons sg_007
      (.cons sg_008 (.cons sg_009 (.cons sg_010 (.cons sg_011 (.cons sg_012 (.cons sg_013 (.cons sg_014 (.cons sg_015
      (.cons sg_016 (.cons sg_017 .nil)))))))))))))))))
  exact step_exact (strictPos_spec _ S.p7).2 S.opts241_pos (step_check hB sgm) pG

/-- K1: the BASE fold list of U3g/V4g (the BASE keys of the U3g/V4g evaluation), kernel-checked. -/
theorem foldBase_eq : foldOrbits 120 [3, 5, 7, 11, 13, 17, 31, 241] = LG := by
  show foldStep 120 (foldStep 120 (foldStep 120 (foldStep 120 (foldStep 120 (foldStep 120 (foldStep 120
    (foldStep 120 [(0, 1)] (optsP 120 3)) (optsP 120 5)) (optsP 120 7)) (optsP 120 11)) (optsP 120 13))
    (optsP 120 17)) (optsP 120 31)) (optsP 120 241) = LG
  rw [step1, step2, step3, step4, step5, step6, step7, step241]

end K45G
