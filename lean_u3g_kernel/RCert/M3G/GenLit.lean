import RCert.M3G.Data

/-! `m3ggenlit`: print the module `RCert/M3G/TeffLit.lean`, the values of `teffD D.data` (27720 exact rationals) and
`R0tD D.data` at period 27720 for the modulus G. -/

open R45.M3 hiding PER accG sumDvd certOK ellPs mkBD prC drC tbC teffOf bsOf teffD
open R45.M3G

def main : IO Unit := do
  let te := teffD D.data
  let r0 := R0tD D.data
  IO.println "/-! Generated by RCert/M3G/GenLit.lean (exe m3ggenlit): `teffD D.data` and `R0tD D.data` at period 27720. -/"
  IO.println ""
  IO.println "namespace R45.M3G"
  IO.println ""
  IO.println "/-- The tail mass bound `R0up - (R0a + R0b) / SC` of the M3 tables (modulus G). -/"
  IO.println s!"def R0tLit : Rat := ({r0.num} : Rat) / {r0.den}"
  IO.println ""
  IO.println "/-! The certified `T(c)` bounds at period 27720 as literals (`c = 0, …, 27719`), in chunks of 990. -/"
  let n := te.length
  let nch := (n + 989) / 990
  for k in List.range nch do
    IO.println ""
    IO.println s!"def teffLit{k} : List Rat := ["
    let part := (te.drop (990 * k)).take 990
    let m := part.length
    for (q, i) in part.zip (List.range m) do
      let sep := if i + 1 < m then "," else "]"
      IO.println s!"  ({q.num} : Rat) / {q.den}{sep}"
  IO.println ""
  IO.println "/-- The certified `T(c)` bounds at period 27720 (`c = 0, …, 27719`). -/"
  let names := (List.range nch).map fun k => s!"teffLit{k}"
  let joined := " ++ ".intercalate names
  IO.println s!"def teffLit : List Rat := {joined}"
  IO.println ""
  IO.println "end R45.M3G"
